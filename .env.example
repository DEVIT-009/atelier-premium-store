# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_API_KEY="your_better_auth_api_key" # api key from better auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your_better_auth_secret" # openssl rand -base64 32

# CRON
CRON_SECRET="your_cron_secret" # openssl rand -base64 32

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bakong KHQR (server only)
BAKONG_TOKEN=               # developer token from api-bakong.nbc.gov.kh (reportedly expires ~every 90 days)
BAKONG_ACCOUNT_ID=          # receiving account, e.g. atelier@aclb
MERCHANT_NAME=              # ASCII, max 25 characters
MERCHANT_CITY=your_merchant_city  # ASCII, max 15, e.g. Phnom Penh
MERCHANT_PHONE=             # optional
STORE_LABEL=                # optional, max 25
TERMINAL_LABEL=             # optional, max 25, e.g. Web
KHQR_EXPIRATION_MINUTES=15
BAKONG_API_URL=             # optional; defaults to https://api-bakong.nbc.gov.kh/v1
PRODUCT_IMAGES_DIR=         # optional, folder for uploaded product images; default storage/products. Must be on a permanent disk

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret